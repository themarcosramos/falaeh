# Porta interna do servidor HTTP do backend
APP_PORT=8080

# Porta publicada no host para a API
API_PORT=8080

# Porta publicada no host para o frontend
WEB_PORT=3000

# Integração com Google Forms para recebimento das avaliações do TCC
# Insira a URL do seu formulário do Google Forms (ex: https://docs.google.com/forms/d/e/.../viewform)
FEEDBACK_GOOGLE_FORMS_URL=

# Campo do formulário (opcional - detectado automaticamente da URL ou do HTML se omitido)
# Exemplo: entry.123456789
FEEDBACK_GOOGLE_FORMS_ENTRY_ID=
